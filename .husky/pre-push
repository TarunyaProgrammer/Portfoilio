#!/usr/bin/env sh
# ─── Husky Pre-Push Hook ───────────────────────────────────────
# Runs full test suite + production build BEFORE every git push.
# If tests fail or build breaks → push is blocked.
# This is the last safety gate before code hits GitHub/Vercel.
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running full test suite before push..."
npm test || { echo "❌ Tests failed. Push blocked."; exit 1; }

echo "🏗  Running production build check before push..."
npm run build || { echo "❌ Build failed. Push blocked."; exit 1; }

echo "✅ All checks passed. Pushing to remote..."
